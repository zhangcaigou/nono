# production: use real models and paper database; mock: frontend integration data
PASA_ENGINE_MODE=mock
PASA_APP_ENV=development
PASA_INTERNAL_TOKEN=change-me

PASA_CRAWLER_PATH=checkpoints/pasa-7b-crawler
PASA_SELECTOR_PATH=checkpoints/pasa-7b-selector
# Use separate GPUs when each 7B model fits on one card; otherwise keep auto.
PASA_CRAWLER_DEVICE=cuda:0
PASA_SELECTOR_DEVICE=cuda:1
PASA_SELECTOR_BATCH_SIZE=8
PASA_SELECTOR_THRESHOLD=0.5
PASA_PRELOAD_MODELS=true
# Reduce CUDA memory fragmentation during variable-size Selector batches.
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
PASA_PROMPTS_PATH=agent_prompt.json
PASA_PAPER_ID_PATH=data/paper_database/id2paper.json
PASA_PAPER_DB_PATH=data/paper_database/cs_paper_2nd.zip
PASA_TITLE_INDEX_PATH=data/paper_database/title_index.sqlite3
SERPER_API_KEY=
OPENALEX_API_KEY=
OPENALEX_EMAIL=
SEMANTIC_SCHOLAR_API_KEY=

# Java-side best-effort abstract enrichment and traceability.
PASA_ENRICHMENT_ENABLED=true
PASA_ENRICHMENT_MAX_PAPERS=40
PASA_ENRICHMENT_CONCURRENCY=6
PASA_SCHOLARLY_API_TIMEOUT=PT6S
# 后端允许推荐分析；前端默认开启，多篇论文合并为一次批量调用。
DEEPSEEK_EVIDENCE_ENABLED=true
DEEPSEEK_MAX_PAPERS=6
DEEPSEEK_CONCURRENCY=4

# Keep this at 1 unless shared-model concurrent inference has been verified.
PASA_MAX_WORKERS=1
PASA_THREADS_NUM=20
PASA_SERPER_CONCURRENCY=2
PASA_LOCAL_SEARCH_PAPERS=20
PASA_EXPAND_REFS_PER_PAPER=12
PASA_MOCK_STEP_DELAY=0.15
PASA_DEBUG=false
PASA_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://10.70.5.169:5173

# Grounded result synthesis: selected Top-N only; candidate pairs are filtered before LLM judgment.
PASA_ANALYSIS_ENABLED=true
PASA_ANALYSIS_TOP_N=6
PASA_ANALYSIS_PAIR_LIMIT=15
PASA_ANALYSIS_BATCH_SIZE=5
PASA_ANALYSIS_ABSTRACT_CHARS=1600
PASA_ANALYSIS_CACHE_MAX_ENTRIES=100
PASA_QUERY_PLANNING_ENABLED=true
PASA_QUERY_PLANNING_TIMEOUT=8
PASA_QUERY_PLANNING_CACHE_MAX_ENTRIES=200
